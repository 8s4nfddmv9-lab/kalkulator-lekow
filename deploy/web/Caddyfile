:8080 {
    root * /srv
    encode zstd gzip

    # Flutter is a single-page application; unknown routes return index.html.
    try_files {path} {path}/ /index.html

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Frame-Options "DENY"
    }

    @fresh path / /index.html /flutter_bootstrap.js /main.dart.js /manifest.json /pwa_service_worker.js /pwa-build-info.json
    header @fresh Cache-Control "no-cache, no-store, must-revalidate"

    file_server
}
